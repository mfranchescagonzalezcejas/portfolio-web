---
import type { ProductMedia } from "../content/inkscroller";
import { siteContentByLocale } from "../content/site";
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../sections/header/SiteHeader";

type SlideMeta = { title: string; description: string };

type Props = {
  content: {
    locale: "en" | "es";
    seo: { title: string; description: string; canonicalPath: string; alternates: Record<"en" | "es" | "x-default", string> };
    home: { label: string; href: string };
    counterpart: { label: string; href: string };
    skipLabel: string;
    hero: { eyebrow: string; title: string; description: string };
    proof: { title: string; items: string[] };
    capabilities: { title: string; items: { capability: string; value: string }[] };
    story: { title: string; steps: { title: string; description: string }[] };
    media: Array<ProductMedia & SlideMeta>;
    beta: { title: string; description: string; action: string; href: string };
  };
};

const { content } = Astro.props;
const site = siteContentByLocale[content.locale];
const firstMedia = content.media[0];
const heroAriaLabel = firstMedia.kind === "capture" ? firstMedia.alt : firstMedia.label;
---

<BaseLayout locale={content.locale} pageSeo={content.seo}>
  <div id="top"></div>
  <a class="skip-link sr-only focus:not-sr-only" href="#inkscroller-content">{content.skipLabel}</a>
  <SiteHeader
    currentLocale={site.locale}
    isHome={false}
    navItems={site.nav}
    languageSwitcher={site.languageSwitcher}
    header={site.header}
    client:load
  />
  <main id="inkscroller-content" class="inkscroller-page">
    <section class="inkscroller-hero" aria-labelledby="inkscroller-title">
      <div class="inkscroller-hero-copy">
        <p class="inkscroller-hero-eyebrow">{content.hero.eyebrow}</p>
        <h1 id="inkscroller-title">{content.hero.title}</h1>
        <p class="inkscroller-hero-desc">{content.hero.description}</p>
      </div>
      <div class="inkscroller-hero-device" aria-label={heroAriaLabel}>
        <div class="carousel-phone">
          <div class="carousel-phone-notch"></div>
          <div class="carousel-phone-screen">
            {firstMedia.kind === "capture" ? (
              <img src={firstMedia.src} alt={firstMedia.alt} width={firstMedia.width} height={firstMedia.height} loading="lazy" decoding="async" />
            ) : (
              <div class="inkscroller-placeholder"><strong>{firstMedia.label}</strong><p>{firstMedia.disclosure}</p></div>
            )}
          </div>
        </div>
      </div>
    </section>
    <section class="inkscroller-proof" aria-labelledby="inkscroller-proof-title">
      <h2 id="inkscroller-proof-title">{content.proof.title}</h2>
      <ul>{content.proof.items.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section class="inkscroller-carousel-section" aria-label="Product carousel">
      <div id="inkscroller-carousel" class="inkscroller-carousel" tabindex="0" role="region" aria-label="Product screenshots carousel">
        <div class="inkscroller-carousel-track">
          {content.media.map((entry, i) => (
            <article class="inkscroller-slide" aria-label={`${entry.title}: ${entry.description}`}>
              <div class="inkscroller-slide-copy">
                <h3 class="inkscroller-slide-title">{entry.title}</h3>
                <p class="inkscroller-slide-desc">{entry.description}</p>
              </div>
              <div class="inkscroller-slide-device">
                <div class="carousel-phone">
                  <div class="featured-phone-notch"></div>
                  <div class="featured-phone-screen">
                    {entry.kind === "capture" ? (
                      <img src={entry.src} alt={entry.alt} width={entry.width} height={entry.height} loading="lazy" decoding="async" />
                    ) : (
                      <div class="inkscroller-placeholder"><strong>{entry.label}</strong><p>{entry.disclosure}</p></div>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
        <button class="inkscroller-arrow inkscroller-prev" aria-label="Previous slide" type="button">&#8592;</button>
        <button class="inkscroller-arrow inkscroller-next" aria-label="Next slide" type="button">&#8594;</button>
        <nav class="inkscroller-dots" aria-label="Carousel navigation">
          {content.media.map((entry, i) => (
            <button class:list={["inkscroller-dot", { active: i === 0 }]} aria-label={`Go to slide ${i + 1}: ${entry.title}`} type="button" data-index={i}></button>
          ))}
        </nav>
      </div>
    </section>
    <section class="inkscroller-beta" aria-labelledby="inkscroller-beta-title">
      <h2 id="inkscroller-beta-title">{content.beta.title}</h2>
      <p>{content.beta.description}</p>
      <a href={content.beta.href}>{content.beta.action}</a>
    </section>
  </main>
</BaseLayout>

<script>
  const carousel = document.getElementById("inkscroller-carousel") as HTMLElement | null;
  if (carousel) {
    const prefersReducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const track = carousel.querySelector(".inkscroller-carousel-track") as HTMLElement | null;
    const prev = carousel.querySelector(".inkscroller-prev") as HTMLButtonElement | null;
    const next = carousel.querySelector(".inkscroller-next") as HTMLButtonElement | null;
    const dots = Array.from(carousel.querySelectorAll(".inkscroller-dot")) as HTMLButtonElement[];
    let timer: ReturnType<typeof setInterval> | null = null;

    function scrollToSlide(index: number) {
      const slides = Array.from(track?.querySelectorAll(".inkscroller-slide") ?? []) as HTMLElement[];
      if (slides[index]) {
        slides[index].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "start" });
      }
      dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    }

    function nextSlide() {
      const slides = Array.from(track?.querySelectorAll(".inkscroller-slide") ?? []) as HTMLElement[];
      const current = dots.findIndex((d) => d.classList.contains("active"));
      scrollToSlide((current + 1) % slides.length);
    }

    function startAutoPlay() {
      if (prefersReducedMotion.matches || timer) return;
      timer = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    carousel.addEventListener("mouseenter", stopAutoPlay);
    carousel.addEventListener("focusin", stopAutoPlay);
    carousel.addEventListener("mouseleave", startAutoPlay);
    carousel.addEventListener("focusout", (e) => {
      if (!carousel.contains(e.relatedTarget as Node | null)) startAutoPlay();
    });

    prev?.addEventListener("click", () => { stopAutoPlay(); scrollToSlide(Math.max(0, dots.findIndex((d) => d.classList.contains("active")) - 1)); });
    next?.addEventListener("click", () => { stopAutoPlay(); nextSlide(); });
    dots.forEach((dot) => dot.addEventListener("click", () => { stopAutoPlay(); scrollToSlide(Number(dot.dataset.index)); }));

    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
        e.preventDefault();
        stopAutoPlay();
        const current = dots.findIndex((d) => d.classList.contains("active"));
        scrollToSlide(e.key === "ArrowLeft" ? Math.max(0, current - 1) : Math.min(dots.length - 1, current + 1));
      }
    });

    if (!prefersReducedMotion.matches) startAutoPlay();
  }
</script>

<style>
  .inkscroller-page { width: min(100% - 2rem, 70rem); margin: auto; display: grid; gap: 4rem; padding: 9rem 0 4rem; overflow-x: clip; }
  
  .inkscroller-hero { display: grid; gap: 2rem; align-items: center; }
  .inkscroller-hero-copy { max-width: 32rem; }
  .inkscroller-hero-eyebrow { color: var(--primary); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; margin: 0; }
  .inkscroller-hero h1 { max-width: 16ch; font: 700 clamp(2.5rem, 8vw, 5rem)/1 var(--font-display); margin: 0.75rem 0 0; }
  .inkscroller-hero-desc { max-width: 36rem; color: var(--muted-foreground); font-size: 1.125rem; line-height: 1.75; margin: 1rem 0 0; }
  .inkscroller-hero-device { display: flex; justify-content: center; }
  
  .inkscroller-proof { padding: 0; }
  .inkscroller-proof h2 { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted-foreground); margin: 0 0 1rem; }
  .inkscroller-proof ul { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
  .inkscroller-proof li { display: inline-flex; align-items: center; padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--accent-teal) 20%, transparent); background: color-mix(in oklab, var(--accent-teal) 6%, transparent); color: var(--accent-teal); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; }
  
  .inkscroller-carousel-section { padding: 0; }
  .inkscroller-carousel { position: relative; width: 100%; }
  .inkscroller-carousel-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 1rem 0 3.5rem; }
  .inkscroller-carousel-track::-webkit-scrollbar { display: none; }
  .inkscroller-slide { flex: 0 0 100%; scroll-snap-align: start; display: flex; flex-direction: column; align-items: center; text-align: center; padding-inline: 0.5rem; gap: 1.5rem; }
  .inkscroller-slide-copy { display: flex; flex-direction: column; gap: 0.35rem; }
  .inkscroller-slide-title { margin: 0; color: var(--foreground); font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; }
  .inkscroller-slide-desc { margin: 0; max-width: 20rem; color: var(--muted-foreground); font-size: 0.9rem; line-height: 1.5; }
  .inkscroller-slide-device { display: flex; justify-content: center; }
  .carousel-phone { position: relative; width: 14rem; height: 28.5rem; border-radius: 2rem; border: 1px solid var(--overlay-border); background: linear-gradient(180deg, var(--surface-elevated), var(--surface)); padding: 0.5rem; box-shadow: var(--shadow-elevated); }
  .carousel-phone-notch { position: absolute; left: 50%; z-index: 2; transform: translateX(-50%); border-radius: 999px; background: var(--device-notch); top: 0.625rem; width: 3.5rem; height: 0.875rem; }
  .carousel-phone-screen { display: flex; height: 100%; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; border-radius: 1.35rem; background: var(--device-screen-start); }
  .carousel-phone-screen img { width: 100%; height: 100%; object-fit: contain; }
  
  .inkscroller-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px; border: 1px solid var(--overlay-border); background: var(--glass-background); backdrop-filter: var(--glass-backdrop); color: var(--foreground); font-size: 1rem; cursor: pointer; transition: background-color .12s, border-color .12s; }
  .inkscroller-arrow:hover, .inkscroller-arrow:focus-visible { background: var(--overlay-bg-hover); border-color: var(--foreground); }
  .inkscroller-prev { left: 0; }
  .inkscroller-next { right: 0; }
  .inkscroller-dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: -2rem; position: relative; z-index: 2; }
  .inkscroller-dot { width: 0.75rem; height: 0.75rem; min-width: 14px; min-height: 14px; border-radius: 999px; border: none; background: var(--overlay-border); cursor: pointer; padding: 0; transition: background-color .12s, transform .12s; }
  .inkscroller-dot.active { background: var(--primary); transform: scale(1.3); }
  .inkscroller-dot:hover { background: var(--muted-foreground); }
  
  .inkscroller-beta { border: 1px solid var(--border); border-radius: var(--radius); padding: clamp(1.5rem, 5vw, 3rem); background: var(--surface); display: grid; gap: 0.75rem; text-align: center; justify-items: center; }
  .inkscroller-beta h2 { font-family: var(--font-display); font-size: clamp(1.25rem, 3vw, 1.75rem); margin: 0; }
  .inkscroller-beta p { color: var(--muted-foreground); max-width: 28rem; margin: 0; }
  .inkscroller-beta a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.25rem; border: 1px solid var(--overlay-border); border-radius: 999px; color: var(--foreground); font-weight: 500; transition: background-color .12s, border-color .12s; text-decoration: none; }
  .inkscroller-beta a:hover { background: var(--overlay-bg-hover); border-color: var(--accent-teal); }
  
  .inkscroller-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem; text-align: center; }
  .inkscroller-placeholder strong { color: var(--device-text-strong); font-family: var(--font-display); font-size: 0.72rem; }
  .inkscroller-placeholder p { color: var(--device-overlay-text); font-family: var(--font-mono); font-size: 0.58rem; margin: 0; }
  
  @media (min-width: 48rem) {
    .inkscroller-hero { grid-template-columns: 1fr 14rem; gap: 3rem; }
    .inkscroller-slide { flex-direction: row; text-align: left; gap: 3rem; padding-inline: 2rem; }
    .inkscroller-slide-copy { flex: 1; max-width: 24rem; }
    .inkscroller-slide-desc { max-width: 28rem; }
  }
</style>
