---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../sections/header/SiteHeader";
import { siteContentByLocale } from "../../../content/site";
import { betaContent } from "../../../content/beta";

const locale = "es";
const site = siteContentByLocale[locale];
const content = betaContent[locale];
---

<BaseLayout locale={locale} site={site} pageSeo={content.seo}>
  <div id="top"></div>
  <a class="skip-link sr-only focus:not-sr-only" href="#beta-content">Saltar al contenido</a>
  <SiteHeader
    currentLocale={site.locale}
    isHome={false}
    navItems={site.nav}
    languageSwitcher={site.languageSwitcher}
    header={site.header}
    client:load
  />
  <main id="beta-content" class="section-shell">
    <section class="section-inner">
      <h1 class="section-title">{content.index.title}</h1>
      <p class="hero-copy">{content.index.description}</p>
      <div class="beta-program-list">
        {content.index.programs.map((program) => (
          <article class="beta-program-card card-surface">
            <div class="beta-program-header">
              <h2 class="beta-program-name">{program.name}</h2>
              <span class="beta-program-status" data-status={program.status}>
                {program.status === "open" ? "Abierta" : program.status === "closed" ? "Cerrada" : "Pausada"}
              </span>
            </div>
            <p class="beta-program-desc">{program.description}</p>
            <a class="beta-cta-primary" href={program.href}>
              {program.status === "open" ? "Más información" : "Ver"}
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .beta-program-list {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .beta-program-card {
    padding: 1.5rem;
    border-radius: var(--radius);
  }
  .beta-program-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .beta-program-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }
  .beta-program-status {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .beta-program-status[data-status="open"] {
    background: color-mix(in oklab, var(--primary) 15%, transparent);
    color: var(--primary);
  }
  .beta-program-desc {
    color: var(--muted-foreground);
    font-size: 0.9rem;
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .beta-cta-primary {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity 0.12s;
  }
  .beta-cta-primary:hover {
    opacity: 0.85;
  }
</style>
