{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": "astro",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "develop": true
    }
  },
  "redirects": [{ "source": "/", "destination": "/en", "permanent": true }],
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/es", "destination": "/es/index.html" }
  ]
}
